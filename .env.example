# Copy to .env and fill in. .env is git-ignored - never commit real values.
#   cp .env.example .env

# ---------------------------------------------------------------- LLM --
# groq | fake   (fake = offline mode: no key needed, deterministic answers)
# If left empty: groq when GROQ_API_KEY is set, otherwise fake.
LLM_PROVIDER=

# Leave empty for the defaults:
#   groq: primary qwen/qwen3.8-27b, fallback openai/gpt-oss-120b
# Set to override (model name exactly as listed in your provider's console).
LLM_MODEL=
LLM_FALLBACK_MODEL=

# Get a free key at https://console.groq.com -> API Keys
GROQ_API_KEY=

# ---------------------------------------------------------------- JWT --
# HS256 signing secret, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If left empty, the app generates one on first start and saves it to data/jwt_secret.
JWT_SECRET=

# Token lifetime in minutes.
TOKEN_TTL_MINUTES=60
