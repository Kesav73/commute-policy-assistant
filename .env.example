# Copy to .env and fill in:   cp .env.example .env
# .env is git-ignored. Never commit real values.

# ------------------------------------------------------------------- LLM --
# Free key: https://console.groq.com -> API Keys.
# Empty = offline mode: a deterministic fake LLM, no key needed.
GROQ_API_KEY=

# ------------------------------------------------------------------- JWT --
# Token signing secret, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty = generated on first start and saved in the data volume.
JWT_SECRET=
TOKEN_TTL_MINUTES=60

# ------------------------------------------- optional (defaults shown) --
# APP_PORT=8000                 host port for the API (change it if 8000 is busy)
# RETRIEVAL_MAX_DISTANCE=0.50   "not covered" when even the closest chunk is farther than this
#
# Time limits, so a request never hangs:
# RETRIEVAL_TIMEOUT_S=1.0       one retrieval (embedding + search)
# REWRITE_TIMEOUT_S=1.2         LLM call 1 (rewrite)
# LLM_TIMEOUT_S=2.0             any single LLM call
# ANSWER_DEADLINE_S=2.8         the whole pipeline
# REQUEST_TIMEOUT_S=3.0         the whole /ask request ("please try again" after this)
#
# Answer cache (repeated questions, same company and policy version):
# ANSWER_CACHE_SIZE=1000        0 turns it off
# ANSWER_CACHE_TTL_S=21600      6 hours
